<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">WORKSPACE</p><h1>ภาพรวมระบบ</h1><p class="muted">ติดตามคำขอแจ้งซ่อมและสถานะงานล่าสุด</p></div><% if(permissions.includes('request.create')){ %><a class="button primary" href="/app/requests/new">＋ แจ้งซ่อมใหม่</a><% } %></div><div class="stats"><% const labels=['รอพิจารณา','อนุมัติแล้ว','ไม่อนุมัติ','กำลังซ่อม','รอตรวจรับ','เสร็จสิ้น']; for(const s of labels){const x=stats.find(a=>a.status===s); %><div class="stat"><span><%= s %></span><strong><%= x?x.count:0 %></strong></div><% } %></div><section class="panel"><div class="panelhead"><h2>รายการล่าสุด</h2><a href="/app/requests">ดูทั้งหมด →</a></div><% if(!recent.length){ %><p class="empty">ยังไม่มีรายการแจ้งซ่อม เริ่มต้นด้วยการสร้างคำขอแรก</p><% }else{ %><div class="tablewrap"><table><thead><tr><th>เลขที่</th><th>หัวข้อ</th><th>ผู้แจ้ง</th><th>สถานะ</th><th>วันที่</th><th></th></tr></thead><tbody><% recent.forEach(r=>{ %><tr><td><%= r.request_no %></td><td><%= r.title %></td><td><%= r.requester %></td><td><span class="status"><%= r.status %></span></td><td><%= new Date(r.created_at).toLocaleDateString('th-TH') %></td><td><a href="/app/requests/<%= r.id %>">เปิด</a></td></tr><% }) %></tbody></table></div><% } %></section><%- include('partials/footer') %>