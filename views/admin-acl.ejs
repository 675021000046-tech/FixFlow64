<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">ROLE × PERMISSION</p><h1>Permission และ ACL</h1><p class="muted">เลือกสิทธิ์ให้แต่ละบทบาท การเปลี่ยนแปลงมีผลทันทีโดยไม่ต้องเริ่ม Server ใหม่</p></div></div><section class="panel"><h2>ตาราง ACL</h2><form method="post" action="/admin/acl"><div class="tablewrap"><table class="acl"><thead><tr><th>Permission</th><% roles.forEach(r=>{ %><th><%= r.name %></th><% }) %></tr></thead><tbody><% perms.forEach(p=>{ %><tr><td><b><%= p.code %></b><small><%= p.name %></small></td><% roles.forEach(r=>{const has=links.some(l=>l.role_id===r.id&&l.permission_id===p.id); %><td class="center"><input type="checkbox" name="role_<%= r.id %>" value="<%= p.id %>" <%= has||r.name==='Admin'?'checked':'' %> <%= r.name==='Admin'?'disabled':'' %>></td><% }) %></tr><% }) %></tbody></table></div><p class="muted">Admin ได้รับทุก Permission เสมอและไม่สามารถยกเลิกจากตารางนี้ได้</p><button class="primary">บันทึก ACL</button></form></section><section class="panel"><h2>เพิ่ม Permission ที่ระบบรองรับ</h2><p class="muted">เพื่อความปลอดภัย เลือกเฉพาะรหัสที่เชื่อมกับ Route/API จริงในระบบ</p><form class="formgrid" method="post" action="/admin/permissions"><label>รหัส Permission<select name="code" required><% const catalog=[['dashboard.read','ดูภาพรวม'],['request.read','ดูคำขอ'],['request.create','สร้างคำขอ'],['request.update.own','แก้ไขคำขอตนเอง'],['request.approve','อนุมัติคำขอ'],['request.assign','มอบหมายช่าง'],['request.work','อัปเดตงานซ่อม'],['request.delete','ลบคำขอ (มีสิทธิ์กำกับ แต่ยังไม่มีปุ่มลบใน UI)'],['file.upload','อัปโหลดไฟล์'],['file.read','ดาวน์โหลดไฟล์'],['file.delete','ลบไฟล์'],['user.manage','จัดการผู้ใช้'],['role.manage','จัดการบทบาท'],['permission.manage','จัดการ ACL'],['log.read','ดู Audit Log']];perms.forEach(p=>{});catalog.filter(x=>!perms.some(p=>p.code===x[0])).forEach(x=>{ %><option value="<%= x[0] %>"><%= x[0] %> — <%= x[1] %></option><% }) %></select></label><label>ชื่อแสดง<input name="name" required></label><label>คำอธิบาย<input name="description"></label><button class="primary">เพิ่ม Permission</button></form><h3>Permission ปัจจุบัน</h3><div class="tablewrap"><table><thead><tr><th>รหัส</th><th>ชื่อ</th><th>คำอธิบาย</th><th></th></tr></thead><tbody><% perms.forEach(p=>{ %><tr><td><%= p.code %></td><td><%= p.name %></td><td><%= p.description %></td><td><% if(p.code!=='dashboard.read'){ %><form method="post" action="/admin/permissions/<%= p.id %>/delete" onsubmit="return confirm('ยืนยันลบ Permission?')"><button class="danger small">ลบ</button></form><% } %></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>