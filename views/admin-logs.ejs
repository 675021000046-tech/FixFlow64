<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">AUDIT TRAIL</p><h1>Audit Log</h1><p class="muted">แสดงล่าสุดไม่เกิน 500 รายการ ข้อมูลเก็บใน PostgreSQL</p></div></div><section class="panel"><form class="filters" method="get"><input name="username" placeholder="ชื่อผู้ใช้" value="<%= filters.username %>"><select name="event"><option value="">ทุกเหตุการณ์</option><% events.forEach(e=>{ %><option value="<%= e.event_type %>" <%= filters.event===e.event_type?'selected':'' %>><%= e.event_type %></option><% }) %></select><label>ตั้งแต่<input type="date" name="from" value="<%= filters.from %>"></label><label>ถึง<input type="date" name="to" value="<%= filters.to %>"></label><button class="primary">กรอง</button></form><div class="tablewrap"><table><thead><tr><th>วันเวลา</th><th>ผู้ใช้</th><th>เหตุการณ์</th><th>ทรัพยากร</th><th>ผล</th><th>รายละเอียด</th><th>IP</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= new Date(l.created_at).toLocaleString('th-TH') %></td><td><%= l.username||'-' %></td><td><%= l.event_type %></td><td><%= l.resource %> <%= l.resource_id||'' %></td><td><span class="status"><%= l.result %></span></td><td><%= l.details %></td><td><%= l.ip_address||'-' %></td></tr><% }) %><% if(!logs.length){ %><tr><td colspan="7" class="empty">ไม่พบ Log ตามเงื่อนไข</td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>