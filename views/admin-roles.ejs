<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">ACCESS CONTROL</p><h1>จัดการบทบาท (Role)</h1><p class="muted">ห้ามลบบทบาท Admin และบทบาทที่ยังมีผู้ใช้งาน</p></div></div><section class="panel"><h2>เพิ่มบทบาท</h2><form class="formgrid" method="post" action="/admin/roles"><label>ชื่อบทบาท<input name="name" required minlength="2" maxlength="50"></label><label>คำอธิบาย<input name="description"></label><button class="primary">เพิ่ม Role</button></form></section><section class="panel"><div class="tablewrap"><table><thead><tr><th>บทบาท</th><th>คำอธิบาย</th><th>จำนวนผู้ใช้</th><th>การจัดการ</th></tr></thead><tbody><% roles.forEach(r=>{ %><tr><td><%= r.name %> <%= r.is_system?'(เริ่มต้น)':'' %></td><td><%= r.description %></td><td><%= r.user_count %></td><td><% if(!['admin','administrator','ผู้ดูแลระบบ'].includes(String(r.name||'').trim().toLowerCase())&&r.user_count===0){ %><form method="post" action="/admin/roles/<%= r.id %>/delete" onsubmit="return confirm('ยืนยันลบบทบาท?')"><button class="danger small">ลบ</button></form><% }else{ %><span class="muted">ลบไม่ได้</span><% } %></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>