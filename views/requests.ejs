<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">REPAIR TICKETS</p><h1>รายการแจ้งซ่อม</h1><p class="muted">รายการที่บัญชีนี้มีสิทธิ์เข้าถึง</p></div><% if(permissions.includes('request.create')){ %><a class="button primary" href="/app/requests/new">＋ แจ้งซ่อมใหม่</a><% } %></div><form class="filters" method="get"><input name="q" placeholder="ค้นหาเลขที่หรือหัวข้อ" value="<%= q %>"><select name="status"><option value="">ทุกสถานะ</option><% ['รอพิจารณา','อนุมัติแล้ว','ไม่อนุมัติ','กำลังซ่อม','รอตรวจรับ','เสร็จสิ้น'].forEach(s=>{ %><option <%= status===s?'selected':'' %>><%= s %></option><% }) %></select><button>ค้นหา</button></form><section class="panel"><div class="tablewrap"><table><thead><tr><th>เลขที่</th><th>หัวข้อ</th><th>ผู้แจ้ง</th><th>ช่าง</th><th>สถานะ</th><th>ความสำคัญ</th><th></th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><%= r.request_no %></td><td><%= r.title %></td><td><%= r.requester %></td><td><%= r.technician||'-' %></td><td><span class="status"><%= r.status %></span></td><td><%= r.priority %></td><td><a href="/app/requests/<%= r.id %>">รายละเอียด</a></td></tr><% }) %><% if(!requests.length){ %><tr><td colspan="7" class="empty">ไม่พบรายการ</td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>