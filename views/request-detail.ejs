<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow"><%= item.request_no %></p><h1><%= item.title %></h1><p class="muted">สร้างเมื่อ <%= new Date(item.created_at).toLocaleString('th-TH') %></p></div><span class="status large"><%= item.status %></span></div><div class="detailgrid"><section class="panel"><h2>รายละเอียดคำขอ</h2><dl><dt>ผู้แจ้ง</dt><dd><%= item.requester %></dd><dt>สถานที่</dt><dd><%= item.location %></dd><dt>ความสำคัญ</dt><dd><%= item.priority %></dd><dt>รายละเอียด</dt><dd class="preserve"><%= item.description %></dd><dt>ช่างผู้รับผิดชอบ</dt><dd><%= item.technician||'ยังไม่ได้มอบหมาย' %></dd><dt>บันทึกผู้จัดการ</dt><dd><%= item.manager_note||'-' %></dd><dt>ผลการซ่อม</dt><dd><%= item.resolution_note||'-' %></dd></dl></section><div class="stack"><% if(permissions.includes('request.approve')&&item.status==='รอพิจารณา'){ %><section class="panel"><h2>พิจารณาคำขอ</h2><form method="post" action="/app/requests/<%= item.id %>/decision"><label>หมายเหตุ<textarea name="note" rows="2"></textarea></label><div class="actions"><button name="decision" value="approve" class="primary">อนุมัติ</button><button name="decision" value="reject" class="danger">ปฏิเสธ</button></div></form></section><% } %><% if(permissions.includes('request.assign')&&item.status!=='ไม่อนุมัติ'&&item.status!=='เสร็จสิ้น'){ %><section class="panel"><h2>มอบหมายช่าง</h2><form method="post" action="/app/requests/<%= item.id %>/assign"><label>ช่างผู้รับผิดชอบ<select name="technician_id" required><option value="">เลือกช่าง</option><% techs.forEach(t=>{ %><option value="<%= t.id %>" <%= item.technician_id===t.id?'selected':'' %>><%= t.full_name %></option><% }) %></select></label><button class="primary">มอบหมายงาน</button></form></section><% } %><% if(permissions.includes('request.work')&&(user.role_name==='Admin'||item.technician_id===user.id)){ %><section class="panel"><h2>อัปเดตงานซ่อม</h2><form method="post" action="/app/requests/<%= item.id %>/work"><label>สถานะ<select name="status"><option>กำลังซ่อม</option><option>รอตรวจรับ</option><option>เสร็จสิ้น</option></select></label><label>บันทึกผล<textarea name="resolution_note" rows="2"><%= item.resolution_note %></textarea></label><button class="primary">บันทึกสถานะ</button></form></section><% } %></div></div><section class="panel"><div class="panelhead"><h2>ไฟล์แนบ</h2><span class="muted">JPG, PNG, WEBP, PDF, TXT · ไม่เกิน <%= process.env.MAX_FILE_MB||5 %> MB</span></div><% if(permissions.includes('file.upload')){ %><form class="uploadform" method="post" action="/app/requests/<%= item.id %>/files" enctype="multipart/form-data"><input type="file" name="attachment" required accept=".jpg,.jpeg,.png,.webp,.pdf,.txt"><button class="primary">อัปโหลดไฟล์</button></form><% } %><% if(files.length){ %><ul class="filelist"><% files.forEach(f=>{ %><li><div><a href="/files/<%= f.id %>"><%= f.original_name %></a><small><%= f.uploader %> · <%= Math.ceil(f.size_bytes/1024) %> KB · <%= new Date(f.created_at).toLocaleString('th-TH') %></small></div><% if(permissions.includes('file.delete')){ %><form method="post" action="/files/<%= f.id %>/delete" onsubmit="return confirm('ยืนยันลบไฟล์?')"><button class="danger small">ลบ</button></form><% } %></li><% }) %></ul><% }else{ %><p class="empty">ยังไม่มีไฟล์แนบ</p><% } %></section><a class="button" href="/app/requests">← กลับรายการ</a><%- include('partials/footer') %>