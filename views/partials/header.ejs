<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | FixFlow</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><a class="brand" href="/app">FixFlow <small>ระบบแจ้งซ่อม</small></a><% if(user){ %><nav><a href="/app">ภาพรวม</a><a href="/app/requests">รายการแจ้งซ่อม</a><% if(permissions.includes('request.create')){ %><a href="/app/requests/new">แจ้งซ่อม</a><% } %><% if(permissions.includes('user.manage')){ %><a href="/admin/users">ผู้ใช้</a><% } %><% if(permissions.includes('role.manage')){ %><a href="/admin/roles">บทบาท</a><% } %><% if(permissions.includes('permission.manage')){ %><a href="/admin/acl">ACL</a><% } %><% if(permissions.includes('log.read')){ %><a href="/admin/logs">Audit Log</a><% } %></nav><div class="profile"><%= user.full_name %><span><%= user.role_name %></span><form method="post" action="/logout"><button class="linkbtn">ออกจากระบบ</button></form></div><% } %></header><main class="container"><% if(flash){ %><div class="notice <%= flash.type==='error'?'bad':'' %>"><%= flash.msg %></div><% } %>