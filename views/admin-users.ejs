<%- include('partials/header',{title}) %><div class="pagehead"><div><p class="eyebrow">ADMINISTRATION</p><h1>จัดการผู้ใช้</h1><p class="muted">สร้างบัญชี เปิดใช้งาน และเปลี่ยนบทบาทผ่านหน้าเว็บ</p></div></div><section class="panel"><h2>เพิ่มผู้ใช้</h2><form method="post" action="/admin/users" class="formgrid"><label>ชื่อผู้ใช้<input name="username" pattern="[A-Za-z0-9_.-]{3,60}" required></label><label>ชื่อที่แสดง<input name="full_name" required></label><label>รหัสผ่าน (อย่างน้อย 8 ตัว)<input type="password" name="password" minlength="8" required></label><label>บทบาท<select name="role_id"><% roles.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></label><button class="primary">สร้างบัญชี</button></form></section><section class="panel"><h2>บัญชีผู้ใช้</h2><div class="tablewrap"><table><thead><tr><th>ID</th><th>ชื่อผู้ใช้</th><th>ชื่อแสดง</th><th>บทบาท</th><th>เปลี่ยนบทบาท</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.id %></td><td><%= u.username %></td><td><%= u.full_name %></td><td><%= u.role_name %></td><td><form class="inlineform" method="post" action="/admin/users/<%= u.id %>/role"><select name="role_id"><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= u.role_id===r.id?'selected':'' %>><%= r.name %></option><% }) %></select><button class="small">บันทึก</button></form></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>